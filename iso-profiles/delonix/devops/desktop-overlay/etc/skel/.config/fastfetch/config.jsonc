// DelonixOS — fastfetch com identidade da casa e os dados que interessam a
// quem opera infra (kernel, cgroup, memória, containers, contexto k8s).
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "/usr/share/delonix/logo.txt",
        "type": "file",
        "color": { "1": "red" },
        "padding": { "top": 1, "right": 3 }
    },
    "display": { "separator": "  " },
    "modules": [
        "break",
        { "type": "title", "color": { "user": "red", "host": "white" } },
        "separator",
        { "type": "os", "key": "sistema " },
        { "type": "kernel", "key": "kernel  " },
        { "type": "uptime", "key": "activo  " },
        { "type": "packages", "key": "pacotes " },
        { "type": "shell", "key": "shell   " },
        { "type": "de", "key": "desktop " },
        { "type": "terminal", "key": "terminal" },
        { "type": "cpu", "key": "cpu     " },
        { "type": "gpu", "key": "gpu     " },
        { "type": "memory", "key": "memória " },
        { "type": "swap", "key": "swap    " },
        { "type": "disk", "key": "disco   " },
        { "type": "localip", "key": "rede    " },
        { "type": "command", "key": "k8s     ", "text": "kubectl config current-context 2>/dev/null || echo '—'" },
        { "type": "command", "key": "runtime ", "text": "delonix --version 2>/dev/null || podman --version 2>/dev/null || echo '—'" },
        "break",
        "colors",
        "break"
    ]
}
