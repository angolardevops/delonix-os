---
# DelonixOS — componente de marca do Calamares.
#
# ESCRITO À MÃO, de propósito. A tentativa anterior era copiar o componente
# `manjaro` durante o build e renomeá-lo — e falhou três vezes por razões de
# ORDEM: o livefs só existe depois da fase live, e o bloco que copiava corria
# antes. O erro que o utilizador via não ajudava nada:
#
#   ERROR: Cowardly refusing to continue startup without branding.
#     "/usr/share/calamares/branding/delonixos/branding.desc"
#
# Como ficheiro do live-overlay, isto é copiado pelo `copy_overlay` na fase
# live, sem depender de nada ter corrido antes.
#
# REGRA QUE CUSTOU CARO: o `componentName` TEM de ser igual ao nome da pasta, e
# a pasta tem de ser igual ao `branding:` do settings.conf (que o manjaro-tools
# escreve a partir do iso_name). Os três: delonixos.
componentName: delonixos

welcomeStyleCalamares: true
welcomeExpandingLogo:  true

windowExpanding: normal
windowSize:      800px,520px
windowPlacement: center

strings:
    productName:         DelonixOS
    shortProductName:    DelonixOS
    version:             1.0
    shortVersion:        1.0
    versionedName:       DelonixOS 1.0 "Acacia"
    shortVersionedName:  DelonixOS 1.0
    bootloaderEntryName: DelonixOS
    productUrl:          https://github.com/angolardevops/delonix-os
    supportUrl:          https://github.com/angolardevops/delonix-os/issues
    knownIssuesUrl:      https://github.com/angolardevops/delonix-os/issues
    releaseNotesUrl:     https://github.com/angolardevops/delonix-os/releases
    donateUrl:           https://www.linkedin.com/in/walter-angolar-02a96b24/

images:
    productLogo:    "logo.png"
    productIcon:    "logo.png"
    productWelcome: "welcome.png"

# CONTRASTE. Na primeira ISO que abriu o instalador, os passos da barra lateral
# liam-se mal: cinzento sobre cinzento-escuro fica abaixo do mínimo de 4.5:1 que
# a WCAG pede para texto normal.
#
# O passo ACTIVO é a informação mais importante do ecrã — "onde estou nesta
# instalação" — por isso ganha fundo próprio e texto quase branco, em vez de ser
# distinguido só pela cor da letra.
style:
    sidebarBackground:    "#14171c"
    sidebarText:          "#c8ccd4"
    sidebarTextSelect:    "#ffffff"
    sidebarTextHighlight: "#7a2530"

slideshow:             "show.qml"
slideshowAPI:          2
