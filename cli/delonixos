""")


# ----------------------------------------------------------------------- fontes
def find_repo() -> Path | None:
    """Onde está o repositório com o perfil base."""
    env = os.environ.get("DELONIXOS_HOME")
    if env and (Path(env) / "iso-profiles").is_dir():
        return Path(env)
    here = Path(__file__).resolve()
    for parent in [here.parent.parent] + list(here.parents):
        if (parent / "iso-profiles" / "delonix").is_dir():
            return parent
    for candidate in (Path.home() / ".local/share/delonixos/delonix-os",
                      Path("/usr/share/delonixos/delonix-os")):
        if (candidate / "iso-profiles").is_dir():
            return candidate
    return None


def ensure_repo(auto_clone=True) -> Path:
    repo = find_repo()
    if repo:
        return repo
    if not auto_clone:
        die("repositório base não encontrado (define DELONIXOS_HOME)")
    dest = Path.home() / ".local/share/delonixos/delonix-os"
    info(f"a obter o perfil base para {dest}")
    dest.parent.mkdir(parents=True, exist_ok=True)
    if not have("git"):
        die("preciso do git para obter o perfil base")
    subprocess.run(["git", "clone", "--depth", "1", REPO_URL, str(dest)], check=True)
    return dest


# ----------------------------------------------------------------------- render
def render_profile(data: dict, inventory_path: Path, out_dir: Path, repo: Path) -> Path:
    """Traduz o inventário num perfil do manjaro-tools em `out_dir`."""
    meta, spec = data["metadata"], data["spec"]
    name = str(meta["name"])
    pkgs = spec.get("packages") or {}
    base = spec.get("extends", BASE_PROFILE)

    edition, profile = (base.split("/") + ["devops"])[:2] if base != "scratch" else (name, "custom")
    dest = out_dir / edition / profile
    if dest.exists():
        shutil.rmtree(dest)
    dest.parent.mkdir(parents=True, exist_ok=True)

    if base == "scratch":
        dest.mkdir(parents=True)
        for f in ("Packages-Root", "Packages-Desktop", "Packages-Live", "Packages-Mhwd"):
            (dest / f).write_text(f"# {name} — gerado pelo delonixos\nbase\nKERNEL\n"
                                  if f == "Packages-Root" else f"# {name}\n")
        (dest / "profile.conf").write_text('displaymanager="none"\n')
        for d in ("root-overlay", "live-overlay", "desktop-overlay"):
            (dest / d).mkdir()
    else:
        src = repo / "iso-profiles" / edition / profile
        if not src.is_dir():
            die(f"perfil base não encontrado: {src}")
        # `symlinks=True` não é detalhe: o /etc/skel tem links para unidades
        # systemd (podman.socket, psd.service) que só existem na máquina
        # instalada. Sem isto, o copytree tenta segui-los e rebenta no host.
        shutil.copytree(src, dest, symlinks=True)

    # --- pacotes acrescentados -------------------------------------------------
    for group, filename in (("desktop", "Packages-Desktop"), ("root", "Packages-Root")):
        extra = pkgs.get(group) or []
        if not extra:
            continue
        target = dest / filename
        with target.open("a") as fh:
            fh.write(f"\n##### acrescentado por {inventory_path.name} #####\n")
            for p in extra:
                fh.write(f"{p}\n")

    aur = pkgs.get("aur") or []
    if aur:
        with (dest / "Packages-Desktop").open("a") as fh:
            fh.write(f"\n##### AUR, acrescentado por {inventory_path.name} #####\n")
            for p in aur:
                fh.write(f"{p}   # [aur]\n")
        aur_list = out_dir / "aur.list"
        base_aur = (repo / "packages/aur.list").read_text() if base != "scratch" else ""
        aur_list.write_text(base_aur + "\n" + "\n".join(str(a) for a in aur) + "\n")

    # --- pacotes removidos -----------------------------------------------------
    remove = {str(r) for r in (pkgs.get("remove") or [])}
    if remove:
        for filename in ("Packages-Desktop", "Packages-Root", "Packages-Live", "Packages-Mhwd"):
            target = dest / filename
            if not target.exists():
                continue
            lines = []
            for line in target.read_text().splitlines():
                token = line.split("#")[0].strip().split()
                if token and token[-1] in remove:
                    lines.append(f"# removido por {inventory_path.name}: {line}")
                else:
                    lines.append(line)
            target.write_text("\n".join(lines) + "\n")

    # --- overlays do utilizador ------------------------------------------------
    for o in spec.get("overlays") or []:
        src = (inventory_path.parent / str(o["src"])).resolve()
        rel = str(o.get("dest", "/")).lstrip("/")
        target = dest / "desktop-overlay" / rel
        target.mkdir(parents=True, exist_ok=True)
        if src.is_dir():
            shutil.copytree(src, target, symlinks=True, dirs_exist_ok=True)
        else:
            shutil.copy2(src, target)

    # --- binários --------------------------------------------------------------
    binaries = spec.get("binaries") or []
    if binaries:
        (out_dir / "binaries.json").write_text(json.dumps(binaries, indent=2))
        for b in binaries:
            if b.get("path"):
                src = (inventory_path.parent / str(b["path"])).resolve()
                target = dest / "desktop-overlay" / str(b["dest"]).lstrip("/")
                target.parent.mkdir(parents=True, exist_ok=True)
                shutil.copy2(src, target)
                os.chmod(target, int(str(b.get("mode", "0755")), 8))

    # --- serviços e identidade -------------------------------------------------
    conf = dest / "profile.conf"
    text = conf.read_text() if conf.exists() else ""
    services = spec.get("services") or {}
    extra_conf = [f"\n##### acrescentado por {inventory_path.name} #####"]
    users = (spec.get("users") or {}).get("live") or {}
    if users.get("name"):
        text = re.sub(r'^username=.*$', f'username="{users["name"]}"', text, flags=re.M)
    if users.get("password"):
        text = re.sub(r'^password=.*$', f'password="{users["password"]}"', text, flags=re.M)
    if services.get("enable"):
        extra_conf.append(f"enable_systemd+=({' '.join(repr(s) for s in services['enable'])})"
                          .replace("'", "'"))
    if services.get("disable"):
        extra_conf.append(f"disable_systemd+=({' '.join(repr(s) for s in services['disable'])})")
    conf.write_text(text + "\n".join(extra_conf) + "\n")

    (out_dir / "metadata.json").write_text(json.dumps({
        "name": name,
        "version": meta.get("version", "1.0.0"),
        "codename": meta.get("codename", ""),
        "kernel": (spec.get("base") or {}).get("kernel", "linux612"),
        "branch": (spec.get("base") or {}).get("branch", "stable"),
        "edition": edition, "profile": profile,
    }, indent=2))
    return dest


def cmd_render(args):
    path = Path(args.file).resolve()
    data = load_inventory(path)
    problems = validate_inventory(data, path)
    if problems:
        for p in problems:
            bad(p)
        die("corrige o inventário antes de renderizar")
    repo = ensure_repo()
    out = Path(args.out or (path.parent / "build/profile")).resolve()
    out.mkdir(parents=True, exist_ok=True)
    dest = render_profile(data, path, out, repo)
    ok(f"perfil gerado em {dest}")
    print(f"  {DIM}(é isto que o buildiso consome){RST}")


# ------------------------------------------------------------------------ build
def cmd_build(args):
    alvo = args.from_distro or detect_host()
    nome_host, versao_host, spec_host = resolve_alvo(alvo)
    spec_host = spec_host or host_spec(alvo)
    for problema in avisos_versao(nome_host, versao_host, spec_host):
        if "desconhecida" in problema or "não é LTS" in problema:
            die(f"{problema}\n  (vê as suportadas: delonixos distros)")
        warn(problema)
    repo = ensure_repo()

    inventory = Path(args.file).resolve() if args.file else None
    if inventory:
        data = load_inventory(inventory)
        problems = validate_inventory(data, inventory)
        if problems:
            for p in problems:
                bad(p)
            die("corrige o inventário antes de construir")
        out = Path(args.out or (inventory.parent / "build/profile")).resolve()
        out.mkdir(parents=True, exist_ok=True)
        info("a traduzir o inventário para um perfil manjaro-tools")
        render_profile(data, inventory, out, repo)
        env_extra = {"DELONIX_PROFILE_OVERRIDE": str(out)}
        info(f"perfil gerado em {out}")
    else:
        env_extra = {}
        info(f"a construir o perfil oficial ({BASE_PROFILE})")

    build_sh = repo / "scripts/build.sh"
    if not build_sh.exists():
        die(f"não encontrei {build_sh}")

    cmd = [str(build_sh)]
    if args.kernel:
        cmd += ["--kernel", args.kernel]
    if args.engine:
        cmd += ["--engine", args.engine]

    print()
    info(f"host: {nome_host} {versao_host} ({spec_host.get('family', '?')}) — "
         f"{'build nativo possível' if spec_host.get('native') else 'build em contentor'}")
    if args.dry_run:
        warn("--dry-run: não vou construir")
        print(f"  {' '.join(cmd)}")
        return

    env = {**os.environ, **env_extra, "DELONIX_REPO_DIR": str(repo)}
    sys.exit(subprocess.run(cmd, cwd=repo, env=env).returncode)


# ------------------------------------------------------------------------- main
def main():
    parser = argparse.ArgumentParser(
        prog="delonixos",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        description=textwrap.dedent(__doc__ or ""),
    )
    parser.add_argument("--version", action="version", version=f"delonixos {VERSION}")
    sub = parser.add_subparsers(dest="cmd", required=True)

    p = sub.add_parser("doctor", help="verifica se esta máquina consegue construir")
    p.add_argument("--distro", help="forçar a distro do host (senão é detectada)")
    p.set_defaults(func=cmd_doctor)

    p = sub.add_parser("distros", help="distros e versões suportadas")
    p.set_defaults(func=cmd_distros)

    p = sub.add_parser("init", help="cria um projecto com inventário YAML")
    p.add_argument("path", nargs="?", help="directoria do projecto (por omissão, a actual)")
    p.add_argument("--distro", help="distro onde vais construir (ubuntu, fedora, arch…)")
    p.add_argument("--name", help="nome da tua distro")
    p.add_argument("--scratch", action="store_true", help="partir do mínimo em vez do perfil oficial")
    p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_init)

    p = sub.add_parser("validate", help="valida o inventário")
    p.add_argument("-f", "--file", default="delonixos.yaml")
    p.set_defaults(func=cmd_validate)

    p = sub.add_parser("render", help="traduz o inventário num perfil manjaro-tools")
    p.add_argument("-f", "--file", default="delonixos.yaml")
    p.add_argument("-o", "--out")
    p.set_defaults(func=cmd_render)

    p = sub.add_parser("build", help="constrói a ISO")
    p.add_argument("--from", dest="from_distro", metavar="DISTRO[:VERSÃO]",
                   help="ubuntu, ubuntu:22.04, fedora:42, zorin:18… "
                        "(por omissão, a detectada; sem versão aplica-se a política)")
    p.add_argument("-f", "--file", help="inventário YAML (sem isto, constrói o perfil oficial)")
    p.add_argument("--kernel")
    p.add_argument("--engine", choices=["podman", "docker"])
    p.add_argument("-o", "--out")
    p.add_argument("--dry-run", action="store_true")
    p.set_defaults(func=cmd_build)

    args = parser.parse_args()
    try:
        args.func(args)
    except KeyboardInterrupt:
        die("interrompido", 130)
    except subprocess.CalledProcessError as e:
        die(f"comando falhou: {e}", e.returncode or 1)


if __name__ == "__main__":
    main()
