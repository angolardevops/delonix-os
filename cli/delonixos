def cmd_init(args):
    project = Path(args.path or ".").resolve()
    name = args.name or (project.name if args.path else "minha-distro")
    distro = args.distro or detect_host()
    project.mkdir(parents=True, exist_ok=True)

    inventory = project / "delonixos.yaml"
    if inventory.exists() and not args.force:
        die(f"{inventory} já existe (usa --force para substituir)")

    inventory.write_text(INVENTORY_TEMPLATE.format(
        name=name, distro=distro, base=("scratch" if args.scratch else BASE_PROFILE),
        file=inventory.name,
    ))

    for sub in ("overlays/etc", "overlays/usr/local/bin", "binaries"):
        (project / sub).mkdir(parents=True, exist_ok=True)
    (project / "overlays/etc/.gitkeep").touch()
    (project / "binaries/README.md").write_text(
        "# binaries\n\nBinários locais a incluir na imagem.\n"
        "Referencia-os no `delonixos.yaml` com `path:` em vez de `url:`.\n")

    print()
    ok(f"projecto criado em {project}")
    print(f"""
  {BLD}Próximos passos{RST}

    1. edita   {inventory.relative_to(Path.cwd()) if project.is_relative_to(Path.cwd()) else inventory}
    2. valida  delonixos validate -f delonixos.yaml
    3. constrói delonixos build   -f delonixos.yaml

  O host detectado foi {BLD}{distro}{RST} — corre `delonixos doctor` para ver se
  tem tudo o que é preciso.
""")


# ---------------------------------------------------------------------- doctor
def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None


def cmd_doctor(args):
    alvo = args.distro or detect_host()
    nome, versao, spec = resolve_alvo(alvo)
    spec = spec or host_spec(alvo)
    fails = 0

    print(f"\n{BLD}Host{RST}")
    if spec.get("family", "unknown") == "unknown":
        warn(f"distro '{nome}' não reconhecida — o build por contentor deve funcionar na mesma")
    else:
        etiqueta = f"{nome} {versao}".strip()
        info_v = spec.get("versions", {}).get(versao, {})
        extras = []
        if info_v.get("lts"):
            extras.append("LTS")
        if info_v.get("base_version"):
            extras.append(f"base: {spec.get('base')} {info_v['base_version']}")
        if spec.get("policy") == "lts" and not args.distro:
            extras.append("política: só LTS")
        problemas = avisos_versao(nome, versao, spec)
        graves = [p for p in problemas if "desconhecida" in p or "não é LTS" in p]
        detalhe = f"família {spec['family']}" + (", " + ", ".join(extras) if extras else "")
        (bad if graves else ok)(f"{etiqueta} ({detalhe})")
        for problema in problemas:
            (bad if problema in graves else warn)(problema)
        fails += len(graves)

    print(f"\n{BLD}Motor de contentores{RST}")
    engine = None
    for candidate in ("podman", "docker"):
        if have(candidate):
            engine = candidate
            ok(f"{candidate} presente")
            break
    if not engine:
        if spec.get("native"):
            warn("sem podman/docker — mas nesta distro o build pode correr nativamente")
        else:
            bad("sem podman nem docker")
            print(f"      {spec['install'].format(pkgs=spec['pkgs'])}")
            fails += 1

    if spec.get("native"):
        print(f"\n{BLD}Build nativo{RST}")
        if have("buildiso"):
            ok("manjaro-tools instalado (dá para construir sem contentor)")
        else:
            warn("sem manjaro-tools; instala com:")
            print(f"      {spec['install'].format(pkgs=spec['pkgs'])}")

    print(f"\n{BLD}Privilégios{RST}")
    if os.geteuid() == 0:
        ok("a correr como root")
    elif have("sudo"):
        ok("sudo disponível (o buildiso precisa de root a sério)")
    else:
        bad("sem sudo e sem root — o buildiso não consegue montar loop devices")
        fails += 1

    print(f"\n{BLD}Recursos{RST}")
    try:
        st = os.statvfs(".")
        free_gb = st.f_bavail * st.f_frsize / 1024**3
        (ok if free_gb >= 35 else warn)(f"{free_gb:.0f} GB livres (recomendado: 35 GB)")
    except OSError:
        pass
    try:
        mem_gb = os.sysconf("SC_PAGE_SIZE") * os.sysconf("SC_PHYS_PAGES") / 1024**3
        (ok if mem_gb >= 8 else warn)(f"{mem_gb:.0f} GB de RAM (recomendado: 8 GB)")
    except (ValueError, OSError):
        pass
    ok(f"{os.cpu_count()} CPUs")

    print(f"\n{BLD}Python{RST}")
    ok(f"python {sys.version_info.major}.{sys.version_info.minor}")
    try:
        import yaml  # noqa: F401
        ok("PyYAML presente")
    except ImportError:
        warn("sem PyYAML — o leitor interno cobre o inventário, mas é limitado")
    try:
        import PIL  # noqa: F401
        ok("Pillow presente (geração da marca)")
    except ImportError:
        warn("sem Pillow — a marca é gerada dentro do contentor, não faz falta aqui")

    print()
    if fails:
        die(f"{fails} pré-requisito(s) em falta")
    ok("pronto para construir")


# -------------------------------------------------------------------- validate
REQUIRED = {"apiVersion", "kind", "metadata", "spec"}


def load_inventory(path: Path) -> dict:
    if not path.exists():
        die(f"inventário não encontrado: {path}")
    data = load_yaml(path)
    if not isinstance(data, dict):
        die(f"{path}: o inventário tem de ser um mapa YAML")
    return data


def validate_inventory(data: dict, path: Path) -> list[str]:
    problems = []
    missing = REQUIRED - set(data)
    if missing:
        problems.append(f"faltam campos de topo: {', '.join(sorted(missing))}")
    if data.get("apiVersion") != "delonixos/v1":
        problems.append(f"apiVersion desconhecida: {data.get('apiVersion')!r} (esperado delonixos/v1)")
    if data.get("kind") != "Distro":
        problems.append(f"kind desconhecido: {data.get('kind')!r} (esperado Distro)")

    meta = data.get("metadata") or {}
    if not meta.get("name"):
        problems.append("metadata.name em falta")
    elif not re.fullmatch(r"[a-z0-9][a-z0-9._-]*", str(meta["name"])):
        problems.append(f"metadata.name inválido: {meta['name']!r} (minúsculas, sem espaços)")

    spec = data.get("spec") or {}
    ext = spec.get("extends", BASE_PROFILE)
    if ext not in (BASE_PROFILE, "scratch"):
        problems.append(f"spec.extends desconhecido: {ext!r} (usa {BASE_PROFILE} ou scratch)")

    pkgs = spec.get("packages") or {}
    for group in ("desktop", "root", "aur", "remove"):
        val = pkgs.get(group)
        if val is None:
            continue
        if not isinstance(val, list):
            problems.append(f"spec.packages.{group} tem de ser uma lista")
            continue
        for item in val:
            if not isinstance(item, str):
                problems.append(f"spec.packages.{group}: entrada inválida {item!r}")
            elif not re.fullmatch(r"[a-z0-9][a-z0-9@._+-]*(=[\w.:+-]+)?", item):
                problems.append(f"spec.packages.{group}: nome inválido {item!r}")

    for i, b in enumerate(spec.get("binaries") or []):
        if not isinstance(b, dict):
            problems.append(f"spec.binaries[{i}] tem de ser um mapa")
            continue
        if not b.get("dest"):
            problems.append(f"spec.binaries[{i}]: falta `dest`")
        if not b.get("url") and not b.get("path"):
            problems.append(f"spec.binaries[{i}]: precisa de `url` ou `path`")
        if b.get("path") and not (path.parent / str(b["path"])).exists():
            problems.append(f"spec.binaries[{i}]: {b['path']} não existe")

    for i, o in enumerate(spec.get("overlays") or []):
        if not isinstance(o, dict) or not o.get("src"):
            problems.append(f"spec.overlays[{i}]: falta `src`")
        elif not (path.parent / str(o["src"])).exists():
            problems.append(f"spec.overlays[{i}]: {o['src']} não existe")

    return problems


def cmd_validate(args):
    path = Path(args.file).resolve()
    data = load_inventory(path)
    print(f"\n{BLD}{path.name}{RST}")
    problems = validate_inventory(data, path)
    for p in problems:
        bad(p)
    if problems:
        die(f"{len(problems)} problema(s) no inventário")
    meta, spec = data["metadata"], data["spec"]
    pkgs = spec.get("packages") or {}
    ok(f"{meta.get('name')} {meta.get('version', '')} — base: {spec.get('extends', BASE_PROFILE)}")
    ok(f"pacotes: +{len(pkgs.get('desktop') or [])} desktop, "
       f"+{len(pkgs.get('root') or [])} root, +{len(pkgs.get('aur') or [])} AUR, "
       f"−{len(pkgs.get('remove') or [])} removidos")
    ok(f"binários: {len(spec.get('binaries') or [])} · overlays: {len(spec.get('overlays') or [])}")
    print()
    ok("inventário válido")


def cmd_distros(args):
    """Onde é que isto corre, e com que versões."""
