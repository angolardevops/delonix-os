# Nomes alternativos que aparecem no /etc/os-release
ALIASES = {"zorinos": "zorin", "pop!_os": "pop", "popos": "pop", "mint": "linuxmint",
           "opensuse": "opensuse-tumbleweed", "rhel": "rhel", "centos": "rocky"}


def _versoes_ordenadas(distro: str) -> list[str]:
    """Da mais recente para a mais antiga, com ordenação numérica correcta."""
    def chave(v):
        return [int(x) if x.isdigit() else 0 for x in re.split(r"[.-]", v)]
    return sorted(DISTROS[distro].get("versions", {}), key=chave, reverse=True)


def resolve_alvo(alvo: str) -> tuple[str, str, dict]:
    """
    "ubuntu" -> ("ubuntu", "24.04", spec)      última LTS
    "ubuntu:22.04" -> versão explícita, validada contra a política
    """
    nome, _, versao = alvo.partition(":")
    nome = ALIASES.get(nome.lower(), nome.lower())
    if nome not in DISTROS:
        return nome, versao or "", {}
    spec = DISTROS[nome]
    versoes = spec.get("versions", {})
    politica = spec.get("policy", "latest")

    if not versao:
        if politica == "lts":
            candidatas = [v for v in _versoes_ordenadas(nome) if versoes[v].get("lts")]
            versao = candidatas[0] if candidatas else (_versoes_ordenadas(nome) or [""])[0]
        else:
            versao = (_versoes_ordenadas(nome) or ["latest"])[0]
    return nome, versao, spec


def avisos_versao(nome: str, versao: str, spec: dict) -> list[str]:
    """Problemas com a versão escolhida — dito antes de gastar uma hora."""
    problemas = []
    versoes = spec.get("versions", {})
    if versao and versoes and versao not in versoes:
        conhecidas = " ".join(_versoes_ordenadas(nome))
        problemas.append(f"versão {versao} desconhecida para {nome} (conhecidas: {conhecidas})")
        return problemas
    info_v = versoes.get(versao, {})
    if spec.get("policy") == "lts" and versoes and not info_v.get("lts"):
        problemas.append(f"{nome} {versao} não é LTS — só damos suporte a LTS nesta família")
    eol = info_v.get("eol")
    if eol:
        # Sem relógio de rede: comparamos com a data de compilação do Python,
        # que chega para apanhar uma versão claramente fora de suporte.
        import datetime
        hoje = datetime.date.today().strftime("%Y-%m")
        if eol < hoje:
            problemas.append(f"{nome} {versao} saiu de suporte em {eol} — sem correcções de segurança")
    return problemas


def detect_host() -> str:
    """`<id>:<versão>` a partir do /etc/os-release, já normalizado."""
    data = {}
    for path in ("/etc/os-release", "/usr/lib/os-release"):
        if os.path.exists(path):
            for line in Path(path).read_text().splitlines():
                if "=" in line:
                    k, v = line.split("=", 1)
                    data[k] = v.strip().strip('"')
            break
    ident = ALIASES.get(data.get("ID", "").lower(), data.get("ID", "").lower())
    versao = data.get("VERSION_ID", "")
    if ident not in DISTROS:
        for like in data.get("ID_LIKE", "").lower().split():
            like = ALIASES.get(like, like)
            if like in DISTROS:
                # Derivada desconhecida: usamos a base, mas a versão é da base,
                # não da derivada — e nesse caso mais vale deixá-la em branco.
                return like
        return ident or "unknown"
    return f"{ident}:{versao}" if versao else ident


def host_spec(name: str) -> dict:
    _, _, spec = resolve_alvo(name)
    if spec:
        return spec
    # Distro desconhecida não é motivo para desistir: com podman, o contentor
    # trata do resto. Só não sabemos dizer como instalar o podman.
    return {"family": "unknown", "install": "(instala o podman com o gestor da tua distro)",
            "pkgs": "podman", "native": False, "versions": {}}


# -------------------------------------------------------------------- YAML leve
def _parse_scalar(v: str):
    v = v.strip()
    if not v:
        return None
    if v[0] in "\"'" and v[-1] == v[0] and len(v) > 1:
        return v[1:-1]
    low = v.lower()
    if low in ("true", "yes", "on"):
        return True
    if low in ("false", "no", "off"):
        return False
    if low in ("null", "~"):
        return None
    if re.fullmatch(r"-?\d+", v):
        return int(v)
    if re.fullmatch(r"-?\d+\.\d+", v):
        return float(v)
    if v.startswith("[") and v.endswith("]"):
        inner = v[1:-1].strip()
        return [_parse_scalar(x) for x in inner.split(",")] if inner else []
    return v


def _mini_yaml(text: str):
    """
    Subconjunto de YAML suficiente para o inventário: mapas, listas, escalares,
    comentários e listas inline. Não suporta âncoras, blocos multi-linha nem
    fluxos complexos — se precisares disso, instala o PyYAML.
    """
    root: dict = {}
    stack = [(-1, root)]
    lines = text.splitlines()
    i = 0
    while i < len(lines):
        raw = lines[i]
        i += 1
        line = raw.split("#")[0].rstrip() if not raw.strip().startswith("#") else ""
        if not line.strip():
            continue
        indent = len(line) - len(line.lstrip())
        content = line.strip()

        while stack and indent <= stack[-1][0]:
            stack.pop()
        parent = stack[-1][1] if stack else root

        if content.startswith("- "):
            item = content[2:].strip()
            if not isinstance(parent, list):
                continue
            if ":" in item and not item.startswith(("\"", "'")):
                k, _, v = item.partition(":")
                obj = {k.strip(): _parse_scalar(v)}
                parent.append(obj)
                stack.append((indent, obj))
            else:
                parent.append(_parse_scalar(item))
            continue

        if ":" in content:
            key, _, value = content.partition(":")
            key = key.strip()
            value = value.strip()
            if value:
                parent[key] = _parse_scalar(value)
            else:
                # o que vem a seguir decide se é mapa ou lista
                nxt = ""
                for j in range(i, len(lines)):
                    if lines[j].strip() and not lines[j].strip().startswith("#"):
                        nxt = lines[j]
                        break
                child = [] if nxt.strip().startswith("- ") else {}
                parent[key] = child
                stack.append((indent, child))
    return root


def load_yaml(path: Path):
    text = path.read_text()
    try:
        import yaml  # type: ignore
        return yaml.safe_load(text)
    except ImportError:
        return _mini_yaml(text)


