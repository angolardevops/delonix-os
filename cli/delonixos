# --------------------------------------------------------------------------- UI
RED, GRN, YLW, BLD, DIM, RST = (
    "\033[31m", "\033[32m", "\033[33m", "\033[1m", "\033[2m", "\033[0m"
) if sys.stdout.isatty() else ("", "", "", "", "", "")


def ok(msg):    print(f"  {GRN}✓{RST} {msg}")
def bad(msg):   print(f"  {RED}✗{RST} {msg}")
def warn(msg):  print(f"  {YLW}!{RST} {msg}")
def info(msg):  print(f"{BLD}→{RST} {msg}")
def die(msg, code=1):
    # Esvaziar o stdout primeiro: sem isto o erro (stderr, sem buffer) aparece
    # ANTES do relatório quando a saída é canalizada — e lê-se ao contrário.
    sys.stdout.flush()
    print(f"{RED}✗{RST} {msg}", file=sys.stderr)
    sys.exit(code)


