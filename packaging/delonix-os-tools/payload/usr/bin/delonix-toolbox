#!/usr/bin/env bash
# delonix-toolbox — the control panel of DelonixOS.
#
#   delonix-toolbox list
#   delonix-toolbox install k8s-extra lang-java
#   delonix-toolbox remove lang-java
#   delonix-toolbox db start postgres redis mongo   (databases ship stopped)
#   delonix-toolbox lab up observability            (Grafana+Prometheus+Loki)
#   delonix-toolbox eyecandy on|off                 (desktop animations)
#   delonix-toolbox unprivileged-ports on|off
#   delonix update                                  (system + Delonix Runtime)
#
# The ISO ships what 90% of people use. What lives here are the specific cases —
# Java, vendor GPU stacks, cloud extras — and the switches for decisions that
# were deliberately left open.
set -euo pipefail

RED=$'\e[31m'; GRN=$'\e[32m'; BLD=$'\e[1m'; DIM=$'\e[2m'; RST=$'\e[0m'

# --- catálogo: perfil -> descrição | pacotes ---------------------------------
declare -A DESC=(
    [lang-rust-multi]="rustup: multiple Rust toolchains per project"
    [lang-node-extra]="yarn + deno + bun"
    [lang-java]="OpenJDK 21 + Maven + Gradle"
    [lang-python-data]="scientific and data Python"
    [cloud-azure]="Azure CLI (AWS and GCP already ship)"
    [k8s-extra]="flux, kubeseal, velero, popeye, kubent"
    [observability]="k6, vector, prometheus binaries"
    [ide-extra]="VS Code, DBeaver, Postman (the house IDE is antigravity)"
    [virt-extra]="firecracker, vagrant, kubevirt CLI"
    [gpu-amd]="ROCm/OpenCL for AMD GPUs (~2 GB)"
    [gpu-nvidia]="CUDA + OpenCL for NVIDIA GPUs (~3 GB)"
    [printing]="CUPS + drivers (kept off the image on purpose)"
    [office]="LibreOffice + Thunderbird (for those who really need them)"
    [delonix]="Delonix Runtime + delonixctl (the house engine)"
    [ai]="Claude Code + Antigravity (reinstall/update)"
    [ai-local]="Ollama: local models on the GPU/NPU already enabled"
    [docs]="Hugo and Zola: static sites (mkdocs already ships)"
    [davinci]="DaVinci Resolve (the download needs a Blackmagic account)"
    [zfs]="ZFS (out-of-tree module — read the warning first)"
    [subtitles]="whisper.cpp + Aegisub: transcribe and caption on the local GPU/NPU"
    [security-audit]="rkhunter + clamav: periodic workstation scan"
)

declare -A PKGS=(
    [lang-rust-multi]="rustup"
    [lang-node-extra]="yarn deno bun"
    [lang-java]="jdk21-openjdk maven gradle"
    [lang-python-data]="python-numpy python-pandas python-matplotlib ipython"
    [cloud-azure]="azure-cli"
    [k8s-extra]="flux-bin kubeseal velero popeye kubent"
    [observability]="k6 vector prometheus"
    [ide-extra]="visual-studio-code-bin dbeaver postman-bin"
    [virt-extra]="firecracker vagrant virtctl-bin"
    [gpu-amd]="rocm-opencl-runtime rocminfo"
    [gpu-nvidia]="cuda opencl-nvidia"
    [printing]="manjaro-printer cups cups-pdf system-config-printer print-manager"
    [office]="libreoffice-still thunderbird hunspell-en_us"
    [delonix]="__delonix__"
    [ai]="claude-code antigravity"
    [ai-local]="ollama"
    [docs]="hugo zola"
    [davinci]="__davinci__"
    [zfs]="zfs-dkms zfs-utils"
    [subtitles]="whisper.cpp-bin aegisub"
    [security-audit]="rkhunter clamav"
)

# --- helpers -----------------------------------------------------------------
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }
info() { printf '%s→%s %s\n' "$BLD" "$RST" "$*"; }
done_() { printf '%s✓%s %s\n' "$GRN" "$RST" "$*"; }

helper() {
    if command -v yay >/dev/null; then echo yay
    elif command -v pamac >/dev/null; then echo "pamac"
    else echo pacman; fi
}

install_delonix() {
    # O motor da casa não está nos repos da Manjaro: vem dos artefactos
    # publicados do delonix-runtime. Preferimos o instalador oficial (sabe
    # escolher a arquitectura e verificar o que descarrega); se não existir,
    # descarregamos os binários directamente.
    local repo="${DELONIX_GH_REPO:-angolardevops/delonix-runtime}"
    local instalador="https://raw.githubusercontent.com/$repo/main/install.sh"

    if curl -fsSL --max-time 20 -o /dev/null -w '%{http_code}' "$instalador" 2>/dev/null | grep -q 200; then
        info "installing the Delonix Runtime with its official installer"
        curl -fsSL "$instalador" | sudo sh && { done_ "Delonix Runtime installed"; return 0; }
        warn "the official installer failed — falling back to the raw binaries"
    fi

    info "installing Delonix Runtime + delonixctl from the published releases"
    local tmp; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
    local base="https://github.com/$repo/releases/latest/download"
    for bin in delonix delonixctl; do
        if curl -fsSL "$base/${bin}-x86_64-unknown-linux-gnu" -o "$tmp/$bin"; then
            sudo install -Dm755 "$tmp/$bin" "/usr/local/bin/$bin"
            done_ "$bin installed"
        else
            printf '%s!%s could not download %s\n' "$RED" "$RST" "$bin"
        fi
    done
}

install_davinci() {
    # O Resolve é proprietário e o ficheiro está atrás de um formulário de
    # registo da Blackmagic: NÃO pode ser descarregado por script. O que dá para
    # automatizar — encontrar o ficheiro, compilar, resolver dependências — fica
    # automatizado; o resto é dito com clareza em vez de falhar sozinho.
    local zip
    zip=$(find "$HOME/Downloads" "$HOME/Transferências" "$PWD" -maxdepth 1 \
          -iname 'DaVinci_Resolve_*_Linux.zip' 2>/dev/null | sort -V | tail -1)

    if [[ -z $zip ]]; then
        cat <<EOF

  ${BLD}DaVinci Resolve needs one manual step${RST}

  The installer sits behind a Blackmagic registration form and cannot be
  downloaded by a script — that is their limitation, not ours.

    1. open  https://www.blackmagicdesign.com/support/family/davinci-resolve-and-fusion
    2. pick "DaVinci Resolve for Linux" (the free version is enough)
    3. save the .zip in ~/Downloads
    4. run again:  delonix-toolbox install davinci

  ${DIM}With the file in place, everything else is automatic.${RST}

EOF
        command -v xdg-open >/dev/null &&
            (xdg-open "https://www.blackmagicdesign.com/support/family/davinci-resolve-and-fusion" >/dev/null 2>&1 &)
        return 1
    fi

    info "found: $(basename "$zip")"
    command -v git >/dev/null || die "git is required"
    local tmp; tmp=$(mktemp -d); trap 'rm -rf "$tmp"' RETURN
    git clone -q https://aur.archlinux.org/davinci-resolve.git "$tmp/davinci-resolve" ||
        die "could not fetch the PKGBUILD"
    cp "$zip" "$tmp/davinci-resolve/"
    info "building (this takes a while — several GB to extract)"
    ( cd "$tmp/davinci-resolve" && makepkg -si --noconfirm ) || die "the build failed"
    done_ "DaVinci Resolve installed"

    cat <<EOF

  ${BLD}Before your first edit${RST}

  The free version of Resolve for Linux ${BLD}cannot read H.264/H.265${RST}: OBS
  recordings will not import directly. Convert them first —

      delonix-video to-davinci ~/Videos/DelonixOS/lesson.mkv

  It also needs a GPU with OpenCL/CUDA. On NVIDIA:  delonix-toolbox install gpu-nvidia

EOF
}

cmd_list() {
    printf '%sAvailable profiles%s\n\n' "$BLD" "$RST"
    for k in $(printf '%s\n' "${!DESC[@]}" | sort); do
        local mark=" "
        [[ ${PKGS[$k]} != "__delonix__" ]] &&
            pacman -Qq ${PKGS[$k]%% *} &>/dev/null && mark="✓"
        printf '  %s %-16s %s%s%s\n' "$mark" "$k" "$DIM" "${DESC[$k]}" "$RST"
    done
    printf '\n%s(✓ = the main package is already installed)%s\n' "$DIM" "$RST"
}

cmd_install() {
    (( $# )) || die "which profiles? $(printf '%s ' "${!DESC[@]}")"
    local h; h=$(helper)
    for profile in "$@"; do
        [[ -v PKGS[$profile] ]] || die "unknown profile: $profile"
        if [[ ${PKGS[$profile]} == "__delonix__" ]]; then install_delonix; continue; fi
        if [[ ${PKGS[$profile]} == "__davinci__" ]]; then install_davinci; continue; fi
        if [[ $profile == zfs ]]; then
            cat <<EOF

  ${BLD}What installing ZFS means on a rolling distro${RST}

  The ZFS module lives OUTSIDE the kernel (its licence keeps it out). Every
  kernel upgrade has to rebuild it, and if that fails — because ZFS does not
  support that kernel yet — the machine boots without your pools.

  It makes sense for: a separate data disk, or a server with a pinned kernel.
  It does not for: the root of a workstation that updates every week.

  If you go ahead, keep \`linux-lts\` installed as a fallback kernel.

EOF
            read -rp "  Continue? [y/N] " r
            [[ ${r,,} == y ]] || { info "cancelled"; continue; }
        fi
        info "$profile — ${DESC[$profile]}"
        case $h in
            yay)    yay -S --needed --noconfirm ${PKGS[$profile]} ;;
            pamac)  pamac install --no-confirm ${PKGS[$profile]} ;;
            pacman) sudo pacman -S --needed --noconfirm ${PKGS[$profile]} ;;
        esac
        done_ "$profile installed"
    done
}

cmd_remove() {
    (( $# )) || die "which profiles should I remove?"
    for profile in "$@"; do
        [[ -v PKGS[$profile] ]] || die "unknown profile: $profile"
        [[ ${PKGS[$profile]} == "__delonix__" ]] && {
            sudo rm -f /usr/local/bin/delonix /usr/local/bin/delonixctl
            done_ "delonix removed"; continue; }
        sudo pacman -Rns --noconfirm ${PKGS[$profile]} || true
        done_ "$profile removed"
    done
}

# --- bases de dados locais ----------------------------------------------------
# Vêm instaladas mas paradas: três servidores a dormir custam ~600 MB de RAM.
# Isto liga-as quando fazem falta e trata do arranque inicial do Postgres.
cmd_db() {
    local action=${1:-status}; shift || true
    local targets=("$@")
    (( ${#targets[@]} )) || targets=(postgres redis mongo)

    _unit() {
        case $1 in
            postgres|postgresql) echo postgresql ;;
            redis|valkey)        echo valkey ;;
            mongo|mongodb)       echo mongodb ;;
            *) die "unknown database: $1 (postgres|redis|mongo)" ;;
        esac
    }

    _initdb() {
        # O Postgres não arranca sem um cluster inicializado — e a mensagem de
        # erro não diz isso a ninguém que seja a primeira vez.
        [[ -s /var/lib/postgres/data/PG_VERSION ]] && return 0
        info "initialising the PostgreSQL cluster (once)"
        sudo -u postgres initdb --locale=C.UTF-8 --encoding=UTF8 \
            -D /var/lib/postgres/data
    }

    for db in "${targets[@]}"; do
        local unit; unit=$(_unit "$db")
        case $action in
            start|on)
                [[ $unit == postgresql ]] && _initdb
                sudo systemctl start "$unit" && done_ "$db running"
                ;;
            enable)
                [[ $unit == postgresql ]] && _initdb
                sudo systemctl enable --now "$unit" && done_ "$db running and enabled at boot"
                ;;
            stop|off)
                sudo systemctl stop "$unit" && done_ "$db stopped"
                ;;
            disable)
                sudo systemctl disable --now "$unit" && done_ "$db disabled"
                ;;
            status)
                printf '  %-10s %s\n' "$db" "$(systemctl is-active "$unit" 2>/dev/null)"
                ;;
            *) die "usage: delonix-toolbox db start|stop|enable|disable|status [postgres redis mongo]" ;;
        esac
    done
}

# --- laboratórios locais ------------------------------------------------------
# Stacks que um SRE quer ligadas algumas horas por semana, não 24/7. Correm em
# containers rootless e não consomem nada quando estão em baixo.
#
# O motor por omissão é o Delonix Runtime — é o motor da casa, e um laboratório
# é exactamente o tipo de carga para que ele foi feito. `--target podman|docker`
# existe para quem ainda não o instalou, ou para comparar comportamentos.
LABS_DIR=/usr/share/delonix/labs
LABS_DATA="${XDG_DATA_HOME:-$HOME/.local/share}/delonix/labs"

cmd_lab() {
    local action=${1:-list}; shift || true
    local lab="" target="${DELONIX_LAB_TARGET:-}"

    while (( $# )); do
        case $1 in
            --target) target=$2; shift 2 ;;
            --target=*) target=${1#*=}; shift ;;
            *) lab=$1; shift ;;
        esac
    done

    # Escolha do motor: o delonix se estiver instalado, senão o que houver.
    if [[ -z $target ]]; then
        if command -v delonix >/dev/null; then target=delonix
        elif command -v podman >/dev/null; then target=podman
        elif command -v docker >/dev/null; then target=docker
        else die "no container engine (install one: delonix-toolbox install delonix)"; fi
    fi
    command -v "$target" >/dev/null || die "engine '$target' is not installed"

    _lab_dir() {
        local d="$LABS_DIR/$1"
        [[ -d $d ]] || die "unknown lab: $1 (see: delonix-toolbox lab list)"
        echo "$d"
    }

    # Prepara a área de dados e resolve o modelo. As configurações só são
    # copiadas na PRIMEIRA vez — o que editares fica.
    _lab_preparar() {
        local nome=$1 origem destino
        origem=$(_lab_dir "$nome")
        destino="$LABS_DATA/$nome"
        mkdir -p "$destino/dados"
        if [[ -d $origem/config && ! -d $destino/config ]]; then
            cp -a "$origem/config" "$destino/config"
            info "configuration copied to $destino/config (yours to edit)"
        fi
        # Directórios de dados que os volumes esperam
        while read -r d; do
            [[ -n $d ]] && mkdir -p "$destino/$d"
        done < <(sed -n 's|.*@LAB_DATA@/\(dados/[a-z-]*\).*|\1|p' "$origem/pod.yaml.in" | sort -u)
        sed "s|@LAB_DATA@|$destino|g" "$origem/pod.yaml.in" >"$destino/pod.yaml"
        echo "$destino"
    }

    case $action in
        list|"")
            printf '%sLabs%s   (engine: %s)\n\n' "$BLD" "$RST" "$target"
            for d in "$LABS_DIR"/*/; do
                [[ -d $d ]] || continue
                local nome; nome=$(basename "$d")
                local desc; desc=$(sed -n '2p' "$d/pod.yaml.in" | sed 's/^# *//')
                printf '  %-16s %s%s%s\n' "$nome" "$DIM" "$desc" "$RST"
            done
            printf '\n  delonix-toolbox lab up <nome> [--target delonix|podman|docker]\n\n'
            ;;

        up)
            [[ -n $lab ]] || die "which one? delonix-toolbox lab up observability"
            local destino; destino=$(_lab_preparar "$lab")
            info "bringing '$lab' up with $target"
            case $target in
                delonix) delonix pod create -f "$destino/pod.yaml" ;;
                podman)  podman kube play --replace "$destino/pod.yaml" ;;
                docker)  _lab_docker_up "$destino/pod.yaml" ;;
            esac || die "failed to bring '$lab' up"
            done_ "'$lab' running"
            [[ -f $(_lab_dir "$lab")/PORTAS ]] && cat "$(_lab_dir "$lab")/PORTAS"
            printf '  data and configuration in: %s\n\n' "$destino"
            ;;

        down|stop)
            [[ -n $lab ]] || die "which one? delonix-toolbox lab down observability"
            local destino="$LABS_DATA/$lab" nome_pod
            nome_pod=$(yq -r '.metadata.name' "$destino/pod.yaml" 2>/dev/null || echo "delonix-$lab")
            case $target in
                delonix) delonix pod rm --force "$nome_pod" ;;
                podman)  podman kube down "$destino/pod.yaml" ;;
                docker)  _lab_docker_down "$destino/pod.yaml" ;;
            esac
            done_ "'$lab' stopped (data kept in $destino)"
            ;;

        status)
            case $target in
                delonix) delonix pod ls 2>/dev/null || warn "no pods running" ;;
                podman)  podman pod ps --filter "name=delonix-" 2>/dev/null ;;
                docker)  docker ps --filter "label=app=delonix-lab" ;;
            esac
            ;;

        logs)
            [[ -n $lab ]] || die "which one?"
            local nome_pod; nome_pod=$(yq -r '.metadata.name' "$LABS_DATA/$lab/pod.yaml" 2>/dev/null)
            case $target in
                delonix) delonix pod logs "$nome_pod" ;;
                podman)  podman pod logs -f "$nome_pod" ;;
                docker)  docker logs -f "${nome_pod}-prometheus" ;;
            esac
            ;;

        *) die "usage: delonix-toolbox lab list|up|down|status|logs [name] [--target engine]" ;;
    esac
}

# O docker não tem `kube play`. Traduzimos o Pod para `docker run`: o primeiro
# container publica as portas e os restantes partilham a sua rede — é o
# equivalente docker de um pod (netns partilhado).
_lab_docker_up() {
    local f=$1 pod primeiro=""
    pod=$(yq -r '.metadata.name' "$f")
    local n; n=$(yq -r '.spec.containers | length' "$f")
    for (( i=0; i<n; i++ )); do
        local nome imagem args env portas montagens
        nome=$(yq -r ".spec.containers[$i].name" "$f")
        imagem=$(yq -r ".spec.containers[$i].image" "$f")
        mapfile -t args < <(yq -r ".spec.containers[$i].args[]? // empty" "$f")
        local cmd=(docker run -d --name "${pod}-${nome}" --label app=delonix-lab --restart unless-stopped)

        if [[ -z $primeiro ]]; then
            while read -r porta; do
                [[ -n $porta ]] && cmd+=(-p "$porta")
            done < <(yq -r ".spec.containers[$i].ports[]? | \"\(.hostPort):\(.containerPort)\"" "$f")
        else
            cmd+=(--network "container:${pod}-${primeiro}")
        fi

        while read -r e; do
            [[ -n $e ]] && cmd+=(-e "$e")
        done < <(yq -r ".spec.containers[$i].env[]? | \"\(.name)=\(.value)\"" "$f")

        while read -r m; do
            [[ -n $m ]] && cmd+=(-v "$m")
        done < <(yq -r "[.spec.volumes[] | {(.name): .hostPath.path}] | add as \$v |
                        .spec.containers[$i].volumeMounts[]? |
                        \"\(\$v[.name]):\(.mountPath)\(if .readOnly then \":ro\" else \"\" end)\"" "$f")

        cmd+=("$imagem" "${args[@]}")
        "${cmd[@]}" >/dev/null || return 1
        [[ -z $primeiro ]] && primeiro=$nome
    done
}

_lab_docker_down() {
    local f=$1 pod; pod=$(yq -r '.metadata.name' "$f")
    docker ps -aq --filter "name=^${pod}-" | xargs -r docker rm -f >/dev/null
}

# --- animações do desktop -----------------------------------------------------
cmd_eyecandy() {
    local state=${1:-}
    local kwin="$HOME/.config/kwinrc" kg="$HOME/.config/kdeglobals"
    case $state in
        on)
            kwriteconfig6 --file "$kg"   --group KDE --key AnimationDurationFactor 1
            kwriteconfig6 --file "$kwin" --group Compositing --key AnimationSpeed 3
            for fx in blur contrast slidingpopups fade scale glide translucency; do
                kwriteconfig6 --file "$kwin" --group Plugins --key "${fx}Enabled" true
            done
            done_ "animations and effects on"
            ;;
        off)
            kwriteconfig6 --file "$kg"   --group KDE --key AnimationDurationFactor 0
            kwriteconfig6 --file "$kwin" --group Compositing --key AnimationSpeed 0
            for fx in blur contrast slidingpopups fade scale glide translucency \
                      magiclamp squash wobblywindows fallapart sheet; do
                kwriteconfig6 --file "$kwin" --group Plugins --key "${fx}Enabled" false
            done
            done_ "animations and effects off (the DelonixOS default)"
            ;;
        *) die "usage: delonix-toolbox eyecandy on|off" ;;
    esac
    qdbus6 org.kde.KWin /KWin reconfigure 2>/dev/null ||
        printf '%s  (log out and back in to apply)%s\n' "$DIM" "$RST"
}

# --- actualizar o sistema e o motor da casa -----------------------------------
# Um comando só para a pergunta "estou actualizado?". Trata das três origens
# que compõem esta distro: os repositórios (Manjaro + [delonix]), o AUR, e os
# binários do Delonix Runtime, que não vêm de repositório nenhum.
cmd_update() {
    local so_delonix=0 verificar=0
    while (( $# )); do
        case $1 in
            --delonix-only) so_delonix=1; shift ;;
            --check|-n)     verificar=1; shift ;;
            *) die "usage: delonix update [--delonix-only] [--check]" ;;
        esac
    done

    if (( verificar )); then
        info "checking for updates (nothing will be installed)"
        checkupdates 2>/dev/null | head -30 ||
            sudo pacman -Sy >/dev/null 2>&1 && pacman -Qu | head -30
        local atual nova
        atual=$(delonix --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
        nova=$(curl -fsSL --max-time 15 \
            "https://api.github.com/repos/${DELONIX_GH_REPO:-angolardevops/delonix-runtime}/releases/latest" \
            2>/dev/null | grep -oP '"tag_name"\s*:\s*"v?\K[^"]+' | head -1)
        printf '\n  Delonix Runtime: instalado %s · disponível %s\n\n' "${atual:-nenhum}" "${nova:-?}"
        return 0
    fi

    if (( ! so_delonix )); then
        info "system (Manjaro + [delonix] + AUR)"
        if command -v yay >/dev/null; then yay -Syu --noconfirm
        else sudo pacman -Syu --noconfirm; fi
        done_ "system updated"
    fi

    # O runtime vem dos artefactos publicados, não de um repositório.
    info "Delonix Runtime"
    local antes; antes=$(delonix --version 2>/dev/null | head -1)
    install_delonix
    local depois; depois=$(delonix --version 2>/dev/null | head -1)
    if [[ $antes == "$depois" && -n $antes ]]; then
        printf '  %salready at the latest version (%s)%s\n' "$DIM" "$antes" "$RST"
    else
        done_ "${antes:-nada} → ${depois:-?}"
    fi

    # Reconstruir o initramfs só se o núcleo ou o splash mudaram — a mensagem
    # importa mais do que o comando: quem não sabe, reinicia sem saber porquê.
    if [[ -n $(find /boot -name 'initramfs-*.img' -newer /var/lib/pacman/db.lck 2>/dev/null) ]]; then
        warn "the kernel was updated — reboot to use it"
    fi
    printf '\n'
    ok_versoes
}

ok_versoes() {
    printf '%sVersions%s\n' "$BLD" "$RST"
    local pares=(
        "DelonixOS:$(pacman -Q delonix-os 2>/dev/null | awk '{print $2}')"
        "runtime:$(delonix --version 2>/dev/null | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)"
        "kernel:$(uname -r)"
        "plasma:$(plasmashell --version 2>/dev/null | awk '{print $2}')"
    )
    for par in "${pares[@]}"; do
        printf '  %-12s %s\n' "${par%%:*}" "${par#*:}"
    done
}

cmd_unprivileged_ports() {
    local state=${1:-}
    case $state in
        on)
            echo 'net.ipv4.ip_unprivileged_port_start = 80' |
                sudo tee /etc/sysctl.d/98-delonix-lowports.conf >/dev/null
            sudo sysctl -w net.ipv4.ip_unprivileged_port_start=80
            done_ "unprivileged processes may now bind from port 80"
            printf '%s  (a deliberate security trade-off — see /etc/sysctl.d/99-delonix.conf)%s\n' "$DIM" "$RST"
            ;;
        off)
            sudo rm -f /etc/sysctl.d/98-delonix-lowports.conf
            sudo sysctl -w net.ipv4.ip_unprivileged_port_start=1024
            done_ "restored the safe value (1024)"
            ;;
        *) die "usage: delonix-toolbox unprivileged-ports on|off" ;;
    esac
}

case ${1:-help} in
    list)                shift; cmd_list "$@" ;;
    install|add)         shift; cmd_install "$@" ;;
    remove|rm)           shift; cmd_remove "$@" ;;
    db)                  shift; cmd_db "$@" ;;
    lab)                 shift; cmd_lab "$@" ;;
    update|upgrade)      shift; cmd_update "$@" ;;
    version|--version)   shift; ok_versoes ;;
    eyecandy)            shift; cmd_eyecandy "$@" ;;
    unprivileged-ports)  shift; cmd_unprivileged_ports "$@" ;;
    help|--help|-h)
        sed -n '2,12p' "$0" | sed 's/^# \?//'
        printf '\n'; cmd_list ;;
    *) die "unknown command: $1 (try: delonix-toolbox help)" ;;
esac
