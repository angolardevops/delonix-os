#!/usr/bin/env bash
# delonix-video — the bridge between OBS and DaVinci Resolve.
#
#   delonix-video to-davinci lesson.mkv      convert to DNxHR (imports cleanly)
#   delonix-video to-davinci ~/Videos/*.mkv  several at once
#   delonix-video publish edited.mov         compress for publishing
#   delonix-video info lesson.mkv
#
# Why this exists: the **free** version of DaVinci Resolve for Linux does not
# decode H.264/H.265 — a Blackmagic licensing limitation, not a distro one. An
# OBS recording (x264) simply does not appear on the timeline, and the error
# explains nothing. Converting to DNxHR fixes it, and it is the workflow every
# tutorial ends up recommending.
#
# Why DNxHR and not ProRes: it decodes faster on x86 CPUs and Resolve reads it
# natively on Linux. The cost is size — ~2 GB per 10 min at 1080p — so the
# original is left where it is and never deleted.
set -euo pipefail

RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; BLD=$'\e[1m'; DIM=$'\e[2m'; RST=$'\e[0m'
info() { printf '%s→%s %s\n' "$BLD" "$RST" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '  %s!%s %s\n' "$YLW" "$RST" "$*"; }
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

command -v ffmpeg >/dev/null || die "ffmpeg is required"

# --- DNxHR profiles -----------------------------------------------------------
# `dnxhr_sq` is the right balance for screen capture: enough quality to edit and
# review, half the size of `hq`. For serious colour grading use `--profile hq`.
profile=dnxhr_sq
outdir=""
delete_source=false

_transcode() {
    local input=$1 output=$2
    [[ -f $input ]] || die "no such file: $input"

    # Audio must be PCM: Resolve does not read AAC on Linux either.
    info "$(basename "$input") → $(basename "$output")"
    ffmpeg -hide_banner -loglevel warning -stats -i "$input" \
        -c:v dnxhd -profile:v "$profile" -pix_fmt yuv422p \
        -c:a pcm_s16le -ar 48000 \
        -movflags +faststart \
        "$output"

    local before after
    before=$(du -h "$input" | cut -f1)
    after=$(du -h "$output" | cut -f1)
    ok "$before → $after   (the original is left untouched)"
    $delete_source && { rm -f "$input"; warn "source deleted as requested"; }
}

cmd_to_davinci() {
    (( $# )) || die "usage: delonix-video to-davinci <file...>"
    for input in "$@"; do
        local output
        if [[ -n $outdir ]]; then
            mkdir -p "$outdir"
            output="$outdir/$(basename "${input%.*}")-dnxhr.mov"
        else
            output="${input%.*}-dnxhr.mov"
        fi
        [[ -e $output ]] && { warn "exists, skipped: $(basename "$output")"; continue; }
        _transcode "$input" "$output"
    done
}

cmd_publish() {
    (( $# )) || die "usage: delonix-video publish <file...>"
    for input in "$@"; do
        local output="${input%.*}-published.mp4"
        info "$(basename "$input") → $(basename "$output")"
        # CRF 20 with `veryslow` at 1080p: the size a one-hour lesson should be,
        # without the terminal text picking up artefacts.
        ffmpeg -hide_banner -loglevel warning -stats -i "$input" \
            -c:v libx264 -preset veryslow -crf 20 -pix_fmt yuv420p \
            -c:a aac -b:a 192k -movflags +faststart \
            "$output"
        ok "$(du -h "$output" | cut -f1)"
    done
}

cmd_info() {
    (( $# )) || die "usage: delonix-video info <file>"
    for f in "$@"; do
        printf '\n%s%s%s\n' "$BLD" "$(basename "$f")" "$RST"
        ffprobe -hide_banner -v error -show_entries \
            format=duration,size,bit_rate:stream=codec_name,codec_type,width,height,r_frame_rate \
            -of default=noprint_wrappers=1 "$f"
        # The warning that matters to anyone editing in the free Resolve.
        if ffprobe -v error -select_streams v:0 -show_entries stream=codec_name \
             -of csv=p=0 "$f" 2>/dev/null | grep -qE '^(h264|hevc)$'; then
            printf '\n  %s!%s H.264/H.265 — the free Resolve for Linux cannot read this.\n' "$YLW" "$RST"
            printf '    delonix-video to-davinci %s\n' "$(basename "$f")"
        fi
    done
    printf '\n'
}

while [[ ${1:-} == --* ]]; do
    case $1 in
        --profile) profile=$2; shift 2 ;;
        --output)  outdir=$2; shift 2 ;;
        --delete-source) delete_source=true; shift ;;
        --help|-h) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) die "unknown option: $1" ;;
    esac
done

case ${1:-help} in
    to-davinci|davinci) shift; cmd_to_davinci "$@" ;;
    publish)              shift; cmd_publish "$@" ;;
    info)                 shift; cmd_info "$@" ;;
    help|--help|-h)       sed -n '2,20p' "$0" | sed 's/^# \?//' ;;
    *) die "unknown command: $1 (try: delonix-video help)" ;;
esac
