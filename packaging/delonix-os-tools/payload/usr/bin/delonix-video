#!/usr/bin/env bash
# `delonix-video` — a ponte entre o OBS e o DaVinci Resolve.
#
#   delonix-video para-davinci aula.mkv        # converte para DNxHR (importa direito)
#   delonix-video para-davinci ~/Vídeos/*.mkv  # vários de uma vez
#   delonix-video publicar aula-editada.mov    # comprime para publicar
#   delonix-video info aula.mkv
#
# Porque é que isto existe: a versão **gratuita** do DaVinci Resolve para Linux
# não descodifica H.264/H.265 — é uma limitação de licenciamento da Blackmagic,
# não da distro. Uma gravação do OBS (x264) simplesmente não aparece na timeline,
# e a mensagem de erro não explica nada. Converter para DNxHR resolve, e é o
# fluxo que qualquer tutorial acaba por recomendar.
#
# Porquê DNxHR e não ProRes: descodifica mais depressa em CPU x86 e o Resolve
# lê-o nativamente em Linux. O custo é o tamanho — ~2 GB por 10 min a 1080p —,
# por isso o original fica onde está e não é apagado.
set -euo pipefail

RED=$'\e[31m'; GRN=$'\e[32m'; YLW=$'\e[33m'; BLD=$'\e[1m'; DIM=$'\e[2m'; RST=$'\e[0m'
info() { printf '%s→%s %s\n' "$BLD" "$RST" "$*"; }
ok()   { printf '  %s✓%s %s\n' "$GRN" "$RST" "$*"; }
warn() { printf '  %s!%s %s\n' "$YLW" "$RST" "$*"; }
die()  { printf '%s✗%s %s\n' "$RED" "$RST" "$*" >&2; exit 1; }

command -v ffmpeg >/dev/null || die "preciso do ffmpeg"

# --- perfis DNxHR -------------------------------------------------------------
# `dnxhr_sq` é o equilíbrio certo para captura de ecrã: qualidade suficiente para
# editar e rever, metade do tamanho do `hq`. Para gradação de cor a sério usa
# `--perfil hq`.
perfil=dnxhr_sq
destino=""
apagar_original=false

_transcodificar() {
    local entrada=$1 saida=$2
    [[ -f $entrada ]] || die "não existe: $entrada"

    # O áudio tem de ser PCM: o Resolve também não lê AAC em Linux.
    info "$(basename "$entrada") → $(basename "$saida")"
    ffmpeg -hide_banner -loglevel warning -stats -i "$entrada" \
        -c:v dnxhd -profile:v "$perfil" -pix_fmt yuv422p \
        -c:a pcm_s16le -ar 48000 \
        -movflags +faststart \
        "$saida"

    local antes depois
    antes=$(du -h "$entrada" | cut -f1)
    depois=$(du -h "$saida" | cut -f1)
    ok "$antes → $depois   (o original fica onde está)"
    $apagar_original && { rm -f "$entrada"; warn "original apagado a pedido"; }
}

cmd_para_davinci() {
    (( $# )) || die "usa: delonix-video para-davinci <ficheiro...>"
    for entrada in "$@"; do
        local saida
        if [[ -n $destino ]]; then
            mkdir -p "$destino"
            saida="$destino/$(basename "${entrada%.*}")-dnxhr.mov"
        else
            saida="${entrada%.*}-dnxhr.mov"
        fi
        [[ -e $saida ]] && { warn "já existe, saltado: $(basename "$saida")"; continue; }
        _transcodificar "$entrada" "$saida"
    done
}

cmd_publicar() {
    (( $# )) || die "usa: delonix-video publicar <ficheiro...>"
    for entrada in "$@"; do
        local saida="${entrada%.*}-publicar.mp4"
        info "$(basename "$entrada") → $(basename "$saida")"
        # CRF 20 com `veryslow` a 1080p: o tamanho que uma aula de uma hora
        # devia ter, sem que o texto do terminal fique com artefactos.
        ffmpeg -hide_banner -loglevel warning -stats -i "$entrada" \
            -c:v libx264 -preset veryslow -crf 20 -pix_fmt yuv420p \
            -c:a aac -b:a 192k -movflags +faststart \
            "$saida"
        ok "$(du -h "$saida" | cut -f1)"
    done
}

cmd_info() {
    (( $# )) || die "usa: delonix-video info <ficheiro>"
    for f in "$@"; do
        printf '\n%s%s%s\n' "$BLD" "$(basename "$f")" "$RST"
        ffprobe -hide_banner -v error -show_entries \
            format=duration,size,bit_rate:stream=codec_name,codec_type,width,height,r_frame_rate \
            -of default=noprint_wrappers=1 "$f"
        # O aviso que interessa a quem edita no Resolve gratuito.
        if ffprobe -v error -select_streams v:0 -show_entries stream=codec_name \
             -of csv=p=0 "$f" 2>/dev/null | grep -qE '^(h264|hevc)$'; then
            printf '\n  %s!%s H.264/H.265 — o Resolve gratuito para Linux não lê isto.\n' "$YLW" "$RST"
            printf '    delonix-video para-davinci %s\n' "$(basename "$f")"
        fi
    done
    printf '\n'
}

while [[ ${1:-} == --* ]]; do
    case $1 in
        --perfil)  perfil=$2; shift 2 ;;
        --destino) destino=$2; shift 2 ;;
        --apagar-original) apagar_original=true; shift ;;
        --help|-h) sed -n '2,20p' "$0" | sed 's/^# \?//'; exit 0 ;;
        *) die "opção desconhecida: $1" ;;
    esac
done

case ${1:-help} in
    para-davinci|davinci) shift; cmd_para_davinci "$@" ;;
    publicar|publish)     shift; cmd_publicar "$@" ;;
    info)                 shift; cmd_info "$@" ;;
    help|--help|-h)       sed -n '2,20p' "$0" | sed 's/^# \?//' ;;
    *) die "comando desconhecido: $1 (tenta: delonix-video help)" ;;
esac
